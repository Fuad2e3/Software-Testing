          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Collect all bounce-notification text (search every string field of each message)\nconst bounceItems = $input.all().filter(i => i.json && Object.keys(i.json).length > 0);\nconst haystacks = bounceItems.map(i => JSON.stringify(i.json).toLowerCase());\n\n// Valid rows that we attempted to send to\nconst validRows = $('Is Valid Email').all();\n\nconst results = [];\nfor (const it of validRows) {\n  const row = it.json;\n  const email = String(row.Email || '').trim().toLowerCase();\n  if (!email) continue;\n  const bounced = haystacks.some(h => h.includes(email));\n  if (bounced) {\n    results.push({ json: { row_number: row.row_number, Status: 'Failed' } });\n  }\n}\nreturn results;"
      },
